# Copy to .env (git-ignored) and adjust. Never commit real values.

# --- MCP server ---------------------------------------------------------
# Dataset directory written by scripts/fetch_data.py (data/secom or data/synthetic)
YIELD_TRIAGE_DATA_DIR=data/synthetic
# Audit log, ticket drafts, used-token ledger
YIELD_TRIAGE_STATE_DIR=.local/state
# Policy profile from src/yield_triage/policy/policy.yaml (triage_run | read_only)
YIELD_TRIAGE_PROFILE=triage_run
# Optional override of the policy file path
YIELD_TRIAGE_POLICY=
# Optional run identifier (1-64 of A-Z a-z 0-9 _ -); generated if empty
YIELD_TRIAGE_RUN_ID=

# --- Approval CLI only (never given to the agent or the server) ---------
# Either a hex key of at least 32 bytes...
YIELD_TRIAGE_APPROVAL_KEY=CHANGE_ME
# ...or a key file path; created owner-only if missing
YIELD_TRIAGE_KEY_FILE=.local/keys/approval.key

# --- Agent / LLM (Phase 3) -----------------------------------------------
# No default on purpose, so a stale model ID is never baked in.
YIELD_TRIAGE_MODEL_ID=CHANGE_ME
# AWS credentials come from the standard chain (profile, SSO, env); not set here.
AWS_REGION=CHANGE_ME
